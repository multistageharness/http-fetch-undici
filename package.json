{
  "name": "fetch-undici",
  "version": "1.0.0",
  "description": "Polyglot HTTP client wrapper for Node.js using Undici - API compatible with fetch-httpx",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sdk": {
      "import": "./dist/sdk/index.js",
      "types": "./dist/sdk/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./exceptions": {
      "import": "./dist/exceptions/index.js",
      "types": "./dist/exceptions/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test:mutation": "stryker run",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run src tests/unit",
    "examples:offline": "npm run build && node examples/09-caching.mjs && node examples/10-connection-pools.mjs && node examples/11-configuration.mjs && node examples/12-streaming-formats.mjs"
  },
  "keywords": [
    "http",
    "client",
    "undici",
    "fetch",
    "httpx",
    "polyglot",
    "rest",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "undici": "^7.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "undici": "^7.19.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  }
}
